# Copy to .env and fill in. .env is gitignored; never commit real values.

# ---- Store selection -------------------------------------------------------
# snowflake | duckdb   (duckdb needs no account; good for local dev and tests)
STORE_BACKEND=duckdb
DUCKDB_PATH=data/nfl_lines.duckdb

# ---- Snowflake (120-day trial) ---------------------------------------------
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
# Use either a password or a key-pair file (key pair recommended).
SNOWFLAKE_PASSWORD=
SNOWFLAKE_PRIVATE_KEY_PATH=
SNOWFLAKE_ROLE=SYSADMIN
SNOWFLAKE_WAREHOUSE=NFL_LINES_WH
SNOWFLAKE_DATABASE=NFL_LINES
SNOWFLAKE_SCHEMA=PUBLIC
# Credits per month before the resource monitor suspends the warehouse.
SNOWFLAKE_CREDIT_CAP=20
# Minutes between DuckDB -> Snowflake syncs in the ingest loop (0 = never).
SNOWFLAKE_SYNC_MINUTES=60
# Cortex models
SNOWFLAKE_EMBED_MODEL=snowflake-arctic-embed-m-v1.5
SNOWFLAKE_COMPLETE_MODEL=claude-sonnet-4-5

# ---- Kalshi ------------------------------------------------------------------
# Market data REST is public. WebSocket and trading need an API key.
KALSHI_BASE_URL=https://external-api.kalshi.com/trade-api/v2
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=
# Minimum 24h volume (contracts) for a Kalshi market to count toward a move.
KALSHI_MIN_VOLUME=500
# Max yes bid-ask spread in dollars for a Kalshi quote to count (brief: 4 cents).
KALSHI_MAX_SPREAD=0.04
KALSHI_POLL_SECONDS=60

# ---- Polymarket (read-only) ---------------------------------------------------
# Same liquidity rules as Kalshi; volume is 24h USD from the Gamma API.
POLYMARKET_MIN_VOLUME=500
POLYMARKET_MAX_SPREAD=0.04

# ---- The Odds API ------------------------------------------------------------
ODDS_API_KEY=
# Comma list. Up to 10 books cost the same as one region.
ODDS_API_BOOKMAKERS=pinnacle,draftkings,fanduel,betmgm,williamhill_us,espnbet
# Stop polling when remaining credits drop below this.
ODDS_API_MIN_CREDITS=50
# Poll live (in-game) odds only when remaining credits exceed this.
ODDS_API_LIVE_MIN_CREDITS=5000

# ---- xAI (Grok x_search) ----------------------------------------------------
XAI_API_KEY=
# false = the ingest loop makes no X searches (xAI bills per call; there is no free tier).
XAI_ENABLED=true
XAI_MODEL=grok-4.20-non-reasoning
# Searches are batched to this many handles; 11 was verified to work in Oct 2026.
XAI_MAX_HANDLES_PER_SEARCH=10
# Cost estimate per call = tokens x price + searches x fee. Calibrate against the Logs
# page on console.x.ai. A 6-hour, 11-handle search was ~51K prompt tokens, 15 searches.
XAI_PRICE_IN_PER_M=1.25
XAI_PRICE_OUT_PER_M=2.5
XAI_SEARCH_FEE_USD=0.005
# Hard daily cap on estimated xAI spend; sweeps stop at XAI_SWEEP_BUDGET_SHARE of it
# so searches for detected moves always have room.
XAI_DAILY_BUDGET_USD=2.0
XAI_SWEEP_BUDGET_SHARE=0.8
XAI_MOVE_COOLDOWN_MINUTES=15

# ---- Optional trading (off by default) -------------------------------------
TRADING_ENABLED=false
DRY_RUN=true
KALSHI_ENV=demo
MAX_ORDER_USD=10
MAX_DAILY_USD=50
MAX_OPEN_EXPOSURE_USD=100
KILL_SWITCH_FILE=trading/KILL

# ---- Misc --------------------------------------------------------------------
RAW_DATA_DIR=data/raw
LOG_LEVEL=INFO
